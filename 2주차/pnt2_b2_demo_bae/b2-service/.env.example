# Supabase 연결 설정. 이 파일을 같은 폴더에 `.env` 로 복사한 뒤 값을 채웁니다.
# `.env` 는 Git 에 올라가지 않습니다. 세 값(URL, ANON_KEY, DB_URL)을 모두 채워야
# Supabase 로그인과 공유 데이터베이스가 켜집니다. 비워 두면 기존처럼 PC 안에만 저장합니다.

# Project Settings > API > Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Project Settings > API Keys > Publishable key (예전 이름: anon public)
SUPABASE_ANON_KEY=

# Connect > Session pooler 의 연결 문자열. [YOUR-PASSWORD] 를 DB 비밀번호로 바꿉니다.
# 비밀번호에 @ : / # 같은 문자가 있으면 URL 인코딩(@ -> %40)해서 넣습니다.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:YOUR-PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# Project Settings > API Keys > Secret key (예전 이름: service_role). 선택 항목.
# 관리 화면에서 계정을 만들거나 비밀번호를 바꿀 때만 씁니다. 절대 공유하거나 Git 에 올리지 마세요.
SUPABASE_SERVICE_ROLE_KEY=

# 관리자 이메일. 로그인할 때마다 관리자 역할로 맞춥니다. 여러 개면 쉼표로 구분합니다.
B2_ADMIN_EMAILS=
