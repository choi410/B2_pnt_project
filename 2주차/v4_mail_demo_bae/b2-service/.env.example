# 이 파일을 .env 로 복사한 뒤 값을 채웁니다. .env 는 Git에 올라가지 않습니다.

# console: 실제로 보내지 않고 서비스 실행 창에 메일 내용과 승인 링크를 출력 (기본값)
# smtp   : 아래 SMTP 계정으로 실제 발송
MAIL_MODE=console

# 네이버: smtp.naver.com / Gmail: smtp.gmail.com (둘 다 587)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# 보내는 주소. 비우면 SMTP_USER를 씁니다.
MAIL_FROM=
MAIL_FROM_NAME=PNT 회의록 서비스

# 메일 속 승인 링크의 앞부분. 보통 비워 둡니다(메일을 보내는 PM이 접속 중인 주소를 사용).
# 이 서버가 실제로 응답하는 주소만 쓸 수 있습니다. 예: http://127.0.0.1:8773
APP_BASE_URL=
# 승인 링크 유효 기간(일)
APPROVAL_EXPIRE_DAYS=7
