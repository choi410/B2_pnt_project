# 이 파일을 같은 폴더에 .env 라는 이름으로 복사해 사용합니다.
# .env 파일은 Git에서 제외됩니다. 개인 비밀번호를 이 예제 파일에 넣지 마세요.
# console: 실제 발송하지 않는 테스트 모드 / smtp: 실제 발송
# 네이버 설정 완료 후 MAIL_MODE=smtp 로 바꾸고 서버를 재시작하세요.
MAIL_MODE=console

# 네이버 메일 > 환경설정 > POP3/IMAP 설정 > POP3/SMTP 설정 > 사용함
# 네이버ID > 보안설정 > 2단계 인증 > 애플리케이션 비밀번호 발급
# 공식 안내: https://help.naver.com/service/30029/contents/21341
SMTP_HOST=smtp.naver.com
SMTP_PORT=465
# 네이버 메일 주소 전체 (예: example@naver.com)
SMTP_USER=
# 일반 로그인 비밀번호가 아닌 애플리케이션 비밀번호
SMTP_PASSWORD=
# 비우면 SMTP_USER 주소로 보냅니다.
MAIL_FROM=
MAIL_FROM_NAME=PNT 회의록 서비스

# 보통 비워 두면 서비스에 접속 중인 주소를 씁니다.
# localhost 주소는 외부 고객이 사용할 수 없습니다. 외부 접속용 서버 설정이 별도로 필요합니다.
APP_BASE_URL=
APPROVAL_EXPIRE_DAYS=7
