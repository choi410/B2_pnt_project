# 이 파일을 같은 폴더에 .env 라는 이름으로 복사해 사용합니다.
# .env 파일은 Git에서 제외됩니다. 개인 비밀번호를 이 예제 파일에 넣지 마세요.
# console: 실제 발송하지 않는 테스트 모드 / smtp: 실제 발송
# 네이버 설정 완료 후 MAIL_MODE=smtp 로 바꾸고 서버를 재시작하세요.
MAIL_MODE=console

# 네이버 메일 > 환경설정 > POP3/IMAP 설정 > POP3/SMTP 설정 > 사용함
# 네이버ID > 보안설정 > 2단계 인증 > 애플리케이션 비밀번호 발급
# 공식 안내: https://help.naver.com/service/30029/contents/21341
SMTP_HOST=smtp.naver.com
SMTP_PORT=465
# 네이버 메일 주소 전체 (예: example@naver.com)
SMTP_USER=
# 일반 로그인 비밀번호가 아닌 애플리케이션 비밀번호
SMTP_PASSWORD=
# 비우면 SMTP_USER 주소로 보냅니다.
MAIL_FROM=
MAIL_FROM_NAME=PNT 회의록 서비스

# 보통 비워 두면 서비스에 접속 중인 주소를 씁니다.
# localhost 주소는 외부 고객이 사용할 수 없습니다. 외부 접속용 서버 설정이 별도로 필요합니다.
APP_BASE_URL=
APPROVAL_EXPIRE_DAYS=7

# ── Supabase 로그인·권한 (아이디·비밀번호 로그인) ──
# supabase: 아이디(employees.app_user_id)·비밀번호 로그인, 관리자 설정 화면 사용 / 비우면 기존 이름 선택 로그인
B2_AUTH_MODE=
# 대시보드 > Connect (또는 Project Settings > Data API)의 Project URL
SUPABASE_URL=
# Project Settings > API Keys의 publishable(또는 anon) 키. secret/service_role 키는 넣지 마세요.
SUPABASE_ANON_KEY=

# ── Supabase DB 직접 연결 (로그인 아이디 조회, 관리자 화면, 벡터DB) ──
# 대시보드 > Connect > Session pooler 연결 문자열 (DB 비밀번호 포함, Git에 올리지 마세요)
SUPABASE_DB_URL=
# 의미 검색 벡터 저장소: sqlite | supabase (비우면 SUPABASE_DB_URL이 있을 때 supabase)
B2_VECTOR_STORE=
# 회의록 저장 시 자동 재색인: 0이면 끔
B2_VECTOR_AUTOSYNC=

# ── 변경이력 승인 ──
# 1(기본): 팀원 검수 후 PM이 회의록 단위로 승인해야 변경이력·AI 답변에 반영 / 0: 검수만으로 바로 반영
B2_CHANGE_APPROVAL=
